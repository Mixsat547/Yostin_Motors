# PostgreSQL del contenedor
POSTGRES_DB=YostinMotors
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave

# Puerto del backend en tu máquina
API_PORT=8080

# Administradores (formato Proveedor:Id, separados por coma)
AUTH_ADMINS=

# Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback